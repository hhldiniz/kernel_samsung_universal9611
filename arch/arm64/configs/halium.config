# Halium / Ubuntu Touch requirements — Samsung Galaxy M31 (Exynos 9611, 4.14)
#
# AUDITED against the device's own /proc/config.gz (M315FXXS4CWK8) on
# 2026-09-02. Most entries below are already satisfied by the stock defconfig
# and are asserted here defensively. These fourteen are REAL changes — the
# stock kernel has them off or absent:
#
#   CONFIG_SYSVIPC              CONFIG_FHANDLE
#   CONFIG_IPC_NS               CONFIG_USER_NS
#   CONFIG_DEVTMPFS_MOUNT       CONFIG_VT
#   CONFIG_CGROUP_DEVICE        CONFIG_CGROUP_PIDS
#   CONFIG_BLK_CGROUP           CONFIG_SQUASHFS (+ _XZ)
#   CONFIG_SECURITY_YAMA        CONFIG_SECURITY_SELINUX_BOOTPARAM
#   CONFIG_USB_CONFIGFS_ECM     CONFIG_SECURITY_APPARMOR (+ SECURITYFS,
#                                                          SECURITY_PATH)
#
# One of those (USER_NS) needs more than a config line — see the note at the
# bottom of this file, and docs/kernel-config-audit.md. Four more lines below
# (the APPARMOR/SELINUX _BOOTPARAM_VALUE and _CHECKREQPROT_VALUE ones) come
# not from the stock audit but from Halium/halium-boot's own reference
# check-kernel-config — also explained at the bottom.

# --- containers and systemd (fatal if missing) ------------------------------
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_FHANDLE=y
CONFIG_SYSVIPC=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_SCHED=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_VT=y
CONFIG_UNIX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_SECCOMP=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# --- filesystems and ACLs ---------------------------------------------------
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_FSNOTIFY=y
CONFIG_INOTIFY_USER=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_RD_LZ4=y
CONFIG_DM_CRYPT=y

# --- security stack Ubuntu Touch expects ------------------------------------
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y            # stock: off — AppArmor cannot build without it
CONFIG_SECURITY_PATH=y         # stock: off — same
CONFIG_SECURITY_APPARMOR=y     # stock: off
CONFIG_SECURITY_APPARMOR_HASH=y
CONFIG_SECURITY_APPARMOR_UNCONFINED_INIT=y
CONFIG_SECURITY_APPARMOR_BOOTPARAM_VALUE=1
# CONFIG_DEFAULT_SECURITY is a non-prompted string with no way to assign it
# directly — it's computed from whichever DEFAULT_SECURITY_* choice member
# below is =y, so THIS is the line that actually picks AppArmor. Verified
# 2026-09-12: setting only CONFIG_DEFAULT_SECURITY="apparmor" as a plain
# fragment line is silently dropped by Kconfig's oldconfig/syncconfig step —
# the built .config came out CONFIG_DEFAULT_SECURITY="selinux" despite it.
CONFIG_DEFAULT_SECURITY_APPARMOR=y
# CONFIG_DEFAULT_SECURITY_SELINUX is not set
CONFIG_DEFAULT_SECURITY="apparmor"   # stock: "selinux" — see the note below
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_DEVELOP=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_SECURITY_SELINUX_BOOTPARAM_VALUE=0
CONFIG_SECURITY_SELINUX_CHECKREQPROT_VALUE=1   # stock: 0
CONFIG_AUDIT=y
CONFIG_AUDITSYSCALL=y

# --- USB gadget: the lifeline when nothing else answers ---------------------
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_ECM=y      # stock: off (RNDIS is already on)
CONFIG_USB_CONFIGFS_MASS_STORAGE=y   # stock: off; usb_moded needs it or it never
                                     # configures USB at all ("all bets are off")

# --- post-mortem for boots that die before any console ----------------------
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# --- must stay off ----------------------------------------------------------
# CONFIG_ANDROID_PARANOID_NETWORK gates socket creation on Android AID groups
# that no Ubuntu process belongs to: leaving it on means "boots, but no network".
# CONFIG_ANDROID_PARANOID_NETWORK is not set
# CONFIG_ANDROID_LOW_MEMORY_KILLER is not set
# CONFIG_NETPRIO_CGROUP is not set
# CONFIG_FW_LOADER_USER_HELPER is not set
#   stock: =y. Halium wants it off, but Samsung may rely on it for some
#   firmware blobs. If Wi-Fi or the modem stops loading firmware, this is the
#   first line to put back.
# CONFIG_DEVKMEM is not set
# CONFIG_COMPAT_BRK is not set
# CONFIG_KGDB is not set

# ---------------------------------------------------------------------------
# One entry above is not just a config line
# ---------------------------------------------------------------------------
#
# CONFIG_USER_NS
#   Stock has it off. Turning it on for the first time on a Samsung 4.14 tree
#   is where the kuid_t errors in sdcardfs and cgroup show up. Patch the tree;
#   do not "fix" it by turning USER_NS back off, since Halium requires it.
#
# --- AppArmor vs SELinux: settled, not a gap --------------------------------
# Linux 4.14 has no LSM stacking: exactly one "major" LSM is active at
# runtime (security_module_enable() in security/security.c only returns true
# for the compiled CONFIG_DEFAULT_SECURITY, or an override on the `security=`
# cmdline). Checked in kOtusin/kernel_samsung_universal9611 branch halium12
# on 2026-09-12: no stacking backport is present, and none is needed —
# CONFIG_DEFAULT_SECURITY="apparmor" above makes AppArmor the sole active
# LSM. SELinux stays compiled in (so libselinux-linked Android userspace
# binaries still work) but its own init() bails out immediately once
# security_module_enable("selinux") is false; it never registers hooks or
# enforces anything. This is Halium's own documented, standard configuration
# for every pre-5.1-kernel port, not a risk unique to this device — see
# Halium/halium-boot's check-kernel-config, whose CONFIGS_EQ block is exactly
# CONFIG_DEFAULT_SECURITY="apparmor" + the three _BOOTPARAM_VALUE /
# _CHECKREQPROT_VALUE lines set above.
