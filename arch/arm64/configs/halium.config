# Halium / Ubuntu Touch requirements — Samsung Galaxy M31 (Exynos 9611, 4.14)
#
# AUDITED against the device's own /proc/config.gz (M315FXXS4CWK8) on
# 2026-09-02. Most entries below are already satisfied by the stock defconfig
# and are asserted here defensively. These fourteen are REAL changes — the
# stock kernel has them off or absent:
#
#   CONFIG_SYSVIPC              CONFIG_FHANDLE
#   CONFIG_IPC_NS               CONFIG_USER_NS
#   CONFIG_DEVTMPFS_MOUNT       CONFIG_VT
#   CONFIG_CGROUP_DEVICE        CONFIG_CGROUP_PIDS
#   CONFIG_BLK_CGROUP           CONFIG_SQUASHFS (+ _XZ)
#   CONFIG_SECURITY_YAMA        CONFIG_SECURITY_SELINUX_BOOTPARAM
#   CONFIG_USB_CONFIGFS_ECM     CONFIG_SECURITY_APPARMOR (+ SECURITYFS,
#                                                          SECURITY_PATH)
#
# One of those (USER_NS) needs more than a config line — see the note at the
# bottom of this file, and docs/kernel-config-audit.md. The LSM choice was
# revised after the first Ubuntu Touch boot; see the security block.

# --- containers and systemd (fatal if missing) ------------------------------
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_FHANDLE=y
CONFIG_SYSVIPC=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_SCHED=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_VT=y
CONFIG_UNIX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_SECCOMP=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# --- filesystems and ACLs ---------------------------------------------------
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_FSNOTIFY=y
CONFIG_INOTIFY_USER=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_RD_LZ4=y
CONFIG_DM_CRYPT=y

# --- security stack Ubuntu Touch expects ------------------------------------
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y            # stock: off — AppArmor cannot build without it
CONFIG_SECURITY_PATH=y         # stock: off — same
CONFIG_SECURITY_APPARMOR=y     # stock: off
CONFIG_SECURITY_APPARMOR_HASH=y
CONFIG_SECURITY_APPARMOR_UNCONFINED_INIT=y
CONFIG_SECURITY_APPARMOR_BOOTPARAM_VALUE=1
# SELinux must be the active LSM (as in stock and the M21 reference kernel).
# Halium 9+ vendor code needs it: vndservicemanager aborts on
# "selinux_status_open(true) >= 0" without selinuxfs, vendor services never
# register on /dev/vndbinder, the Exynos composer@2.1 never appears and Mir
# cannot open the HWC HAL (observed on SM-M315F, 2026-09-13). 4.14 has no LSM
# stacking, so AppArmor stays compiled in but inactive for now. The container
# runs SELinux permissive via androidboot.selinux=permissive.
CONFIG_DEFAULT_SECURITY_SELINUX=y
# CONFIG_DEFAULT_SECURITY_APPARMOR is not set
CONFIG_DEFAULT_SECURITY="selinux"
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_DEVELOP=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
# Must be 1: 0 disables SELinux at boot even when it is the default LSM.
CONFIG_SECURITY_SELINUX_BOOTPARAM_VALUE=1
CONFIG_SECURITY_SELINUX_CHECKREQPROT_VALUE=0   # stock
CONFIG_AUDIT=y
CONFIG_AUDITSYSCALL=y

# --- USB gadget: the lifeline when nothing else answers ---------------------
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_ECM=y      # stock: off (RNDIS is already on)
CONFIG_USB_CONFIGFS_MASS_STORAGE=y   # stock: off; usb_moded needs it or it never
                                     # configures USB at all ("all bets are off")

# --- Bluetooth bridge ---------------------------------------------------------
# Stock has the whole Linux Bluetooth stack off (Samsung runs Bluetooth in
# Android userspace over SCSC). Ubuntu Touch's bluebinder bridges the Android
# Bluetooth HAL into BlueZ through /dev/vhci and needs /dev/rfkill; without
# them it exits with "Failed to open /dev/rfkill" and restarts endlessly
# (269 times in one boot, SM-M315F 2026-09-13). Matches the M21 kernel.
CONFIG_RFKILL=y
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_HCIVHCI=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=y
CONFIG_BT_HIDP=y

# --- system suspend ---------------------------------------------------------
# repowerd suspends through libsuspend, which tries earlysuspend, then
# /sys/power/autosleep, then a "legacy" backend that refuses to run whenever
# /sys/power/wake_lock exists. Stock has wakelocks but not autosleep (Android
# suspends from userspace), so repowerd logged "Failed to initialize
# libsuspend" and the phone never slept (SM-M315F, 2026-09-14).
CONFIG_PM_WAKELOCKS=y
CONFIG_PM_AUTOSLEEP=y

# --- post-mortem for boots that die before any console ----------------------
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# --- must stay off ----------------------------------------------------------
# CONFIG_ANDROID_PARANOID_NETWORK gates socket creation on Android AID groups
# that no Ubuntu process belongs to: leaving it on means "boots, but no network".
# CONFIG_ANDROID_PARANOID_NETWORK is not set
# CONFIG_ANDROID_LOW_MEMORY_KILLER is not set
# CONFIG_NETPRIO_CGROUP is not set
# CONFIG_FW_LOADER_USER_HELPER is not set
#   stock: =y. Halium wants it off, but Samsung may rely on it for some
#   firmware blobs. If Wi-Fi or the modem stops loading firmware, this is the
#   first line to put back.
# CONFIG_DEVKMEM is not set
# CONFIG_COMPAT_BRK is not set
# CONFIG_KGDB is not set

# ---------------------------------------------------------------------------
# One entry above is not just a config line
# ---------------------------------------------------------------------------
#
# CONFIG_USER_NS
#   Stock has it off. Turning it on for the first time on a Samsung 4.14 tree
#   is where the kuid_t errors in sdcardfs and cgroup show up. Patch the tree;
#   do not "fix" it by turning USER_NS back off, since Halium requires it.
#
# --- AppArmor vs SELinux ----------------------------------------------------
# An earlier revision made AppArmor the only active LSM, following Halium's
# legacy halium-boot check-kernel-config. That predates Treble: on Halium 12
# it broke vndservicemanager and, through it, the display HAL (see the
# security block above and docs/kernel-config-audit.md). SELinux is active
# again; running AppArmor alongside it needs an LSM stacking backport.
